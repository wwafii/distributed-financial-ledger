# =============================================================================
# DISTRIBUTED FINANCIAL LEDGER & FRAUD ENGINE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy file ini menjadi '.env' untuk pengembangan lokal:
#   cp .env.example .env
#
# Seluruh microservice di Go membaca variabel ini via os.Getenv() dengan safe fallback.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SHARED INFRASTRUCTURE (PostgreSQL, Redis, Kafka, Jaeger)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ledger_db?sslmode=disable
REDIS_ADDR=localhost:6380
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC=transaction.created
KAFKA_DLQ_TOPIC=transaction.dlq
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# -----------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT, RBAC & Webhooks)
# -----------------------------------------------------------------------------
AUTH_ENABLED=true
JWT_SECRET=super-secret-production-grade-signing-key-32b
ADMIN_SECRET=admin-secret-dev-key
WEBHOOK_SECRET=default-webhook-shared-secret-key

# -----------------------------------------------------------------------------
# 3. SERVICE PORTS
# -----------------------------------------------------------------------------
# API Gateway Service
HTTP_PORT=8000
LEDGER_GRPC_ADDR=localhost:9101

# Core Ledger Service
GRPC_PORT=9101
METRICS_PORT_LEDGER=9111

# Real-Time Fraud Engine Service
KAFKA_GROUP_ID_FRAUD=fraud-engine-v1
METRICS_PORT_FRAUD=9102

# Notification & DLQ Worker Service
KAFKA_GROUP_ID_NOTIF=notification-worker-v1
METRICS_PORT_NOTIF=9103
WEBHOOK_TARGET_URL=http://localhost:8088/api/v1/webhook
NOTIFICATION_CONCURRENCY=5
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_INITIAL_BACKOFF_MS=500

# -----------------------------------------------------------------------------
# 4. FRAUD ENGINE SLIDING-WINDOW THRESHOLDS
# -----------------------------------------------------------------------------
FRAUD_WINDOW_DURATION_SEC=60
FRAUD_MAX_IN_WINDOW=10
FRAUD_BURST_WINDOW_SEC=10
FRAUD_MAX_BURST=3
FRAUD_CUMULATIVE_AMOUNT_THRESHOLD=100000000
FRAUD_HIGH_AMOUNT_THRESHOLD=50000000
